@model IEnumerable<Domain.Models.Hotels.Hotel>

@{
    ViewData["Title"] = "لیست هتل‌ها";
}

<h2>@ViewData["Title"]</h2>

<a class="btn btn-success mb-3" asp-action="Create">افزودن هتل جدید</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>نام</th>
            <th>شهر</th>
            <th>ایمیل</th>
            <th>ستاره</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hotel in Model)
        {
            <tr>
                <td>@hotel.Name</td>
                <td>@hotel.City</td>
                <td>@hotel.Email</td>
                <td>@hotel.Star</td>
                <td>@(hotel.State ? "فعال" : "غیرفعال")</td>
                <td>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@hotel.Id">ویرایش</a>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@hotel.Id">جزئیات</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@hotel.Id">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
