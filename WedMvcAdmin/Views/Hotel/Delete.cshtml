@model Domain.Models.Hotels.Hotel

@{
    ViewData["Title"] = "حذف هتل";
}

<h2>@ViewData["Title"]</h2>

<h4>آیا مطمئن هستید که می‌خواهید این هتل را حذف کنید؟</h4>

<div class="form-group">
    <strong>نام:</strong> @Model.Name
</div>
<div class="form-group">
    <strong>شهر:</strong> @Model.City
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">حذف</button>
    <a asp-action="Index" class="btn btn-secondary">انصراف</a>
</form>
