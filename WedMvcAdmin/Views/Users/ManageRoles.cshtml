
@{
    ViewData["Title"] = "ManageRoles";
}
@{
    Layout = null;
}  <!-- خیلی مهم برای جلوگیری از لود layout داخل مودال -->
@model ManageUserRolesViewModel
<h2 class ="animate__animated animate__bounce">تخصیص نقش به کاربر</h2>

<h5>کاربر با ایدی @Model.UserId</h5>

<form asp-action="ManageRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label></label>
        @foreach (var role in Model.AvailableRoles)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role"
                @(Model.AssignedRoles.Contains(role) ? "checked" : "") />
                <label class="form-check-label">
                    @role
                </label>
            </div>
        }
    </div>

    <button type="submit" class="btn outlined o-second c-second">ثبت</button>
</form>
