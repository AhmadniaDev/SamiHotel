@{
    ViewData["Title"] = "اتاق";
}

<br />
<button onclick="Create()" class="btn outlined o-glass c-glass"> ایجاد </button>

<div id="DataContainer">
</div>

@section Scripts{
    <script>

          document.addEventListener('DOMContentLoaded', async function() {
          await Load(1);
         });

        async function Load(page){
             
            var response = await fetch("/Room/GetList?page=" + page );
            if(response.ok)
            {
                var res = await response.text();
                var Container = document.getElementById('DataContainer');
                Container.innerHTML = res;
            }
        }

        async function GetList(page){

              const searchTxt = document.getElementById("SearchInput").value;

            var response = await fetch("/Room/GetList?page=" + page + "&search=" + searchTxt );
            if(response.ok)
            {
                var res = await response.text();
                var Container = document.getElementById('DataContainer');
                Container.innerHTML = res;
            }
        }

        async function Search(){
            const searchTxt = document.getElementById("SearchInput").value;
            var response = await fetch("/Room/GetList?search=" + searchTxt);
            if(response.ok)
            {
                var res = await response.text();
                var Container = document.getElementById('DataContainer');
                Container.innerHTML = res;
            }
        }


        async function Create()
        {
            $('#MyModal').modal('show');
                    
            var response = await fetch("/Room/Create");
            if(response.ok)
            {
                var res = await response.text();
                 $('#Modalbody').html(res);
            }
        }

        async function Edit(id , page){
            $('#MyModal').modal('show');

            var response = await fetch("/Room/UpdateView/" + id + "?page=" + page);
            if(response.ok)
            {
                var res = await response.text();
                 $('#Modalbody').html(res);
            }

        }

         async function SendCreate()
        {
            const form = document.getElementById('createForm');
            const formData = new FormData(form);

            try {
                const response = await fetch('/Room/CreateRoom', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (response.ok) {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: "top-start",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.onmouseenter = Swal.stopTimer;
                            toast.onmouseleave = Swal.resumeTimer;
                        }
                    });
                    Toast.fire({
                        icon: "success",
                        title: "عملیات با موفقیت انجام شد"
                    });


                    $('#MyModal').modal('hide');

                } else {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: "top-start",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.onmouseenter = Swal.stopTimer;
                            toast.onmouseleave = Swal.resumeTimer;
                        }
                    });
                    Toast.fire({
                        icon: "error",
                        title: result.details
                    });
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }
        }
         async function SendEdit(page)
        {
            const form = document.getElementById('EditForm');
            const formData = new FormData(form);

            try {
                const response = await fetch('/Room/UpdateRoom', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (response.ok) {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: "top-start",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.onmouseenter = Swal.stopTimer;
                            toast.onmouseleave = Swal.resumeTimer;
                        }
                    });
                    Toast.fire({
                        icon: "success",
                        title: "عملیات با موفقیت انجام شد"
                    });


                    $('#MyModal').modal('hide');

                } else {
                    const Toast = Swal.mixin({
                        toast: true,
                        position: "top-start",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        didOpen: (toast) => {
                            toast.onmouseenter = Swal.stopTimer;
                            toast.onmouseleave = Swal.resumeTimer;
                        }
                    });
                    Toast.fire({
                        icon: "error",
                        title: result.details
                    });
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }
        }


        async function Delete(id, page) {
          const result = await Swal.fire({
            title: "آیا مطمئن هستید؟",
            text: "این عملیات قابل بازگشت نیست!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            cancelButtonText: 'بله، حذف کن!',
            confirmButtonText: 'انصراف',
          });

          if (result.isConfirmed) {
            const Data = {
              Id: id,
            };

            try {
              const response = await fetch("/Room/DeleteRoom/", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify(Data),
              });

              const resultJson = await response.json();

              if (response.ok) {
                UseSwal("success", "عملیات با موفقیت انجام شد");
                // اگر نیاز به رفرش یا ریدایرکت به صفحه دارید:
                // window.location.href = `/Room/List?page=${page}`;
              } else {
                UseSwal("error", resultJson.details || "خطایی رخ داده است");
              }
            } catch (error) {
              console.error("Fetch error:", error);
              UseSwal("error", "خطا در ارتباط با سرور");
            }
          }
        }


        // function Delete(id , page)
        // {

        //     var func = () => {
        //         const data = {
        //             Id: id,
        //         };

        //         PostJson("Rooms/DeleteRoom", data, () => GetList(page));
        //     }

        //     DeleteWithSwal(func);
        // }

    </script>
}
