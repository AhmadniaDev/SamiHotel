@using Application.Common.Pagination
@using Domain.Models.Rooms
@model PaginatedList<Room>


<div class="card shade h-100">
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">عکس </th>
                    <th scope="col">نام</th>
                    <th scope="col">تعداد</th>
                    <th scope="col">تعداد تخت </th>
                    <th scope="col">ویو اتاق </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <th scope="row"><img src="/api/file/GetFile?fileName=@item.path" width="200" /></th>
                        <td>@item.Name</td>
                        <td>@item.Qty</td>
                        <td>@item.MainCapaciary</td>
                        <td>@item.View</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav aria-label="Page navigation example">
        <ul class="pagination secondary">
            @if(Model.HasPreviousPage)
            {
                <li onclick="GetList(@Model.PageNumber - 1)" class="page-item"><a class="page-link" >قبلی</a></li>
            }


         @*    <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li> *@
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li onclick="GetList(@i)" class="page-item  @(i == Model.PageNumber ?"active" :"")"><a class="page-link">@i</a></li>
            }
            @if(Model.HasNextPage)
            {

                <li onclick="GetList(@Model.PageNumber + 1)" class="page-item "><a class="page-link">بعدی</a></li>
            }
          @*   <li class="page-item disabled"><a class="page-link" href="#">بعدی</a></li> *@
        </ul>
    </nav>
</div>
