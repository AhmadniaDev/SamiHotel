@{
    ViewData["Title"] = "Index";
}

<button onclick="Create()" class="btn outlined o-glass c-glass">ایجاد بازه قیمت</button>
<br />
<br />

<div class="card shade">
    <div class="card-footer d-flex justify-content-between">
        <div>
            <button onclick="lastWeek()" class="btn btn-outline-secondary">قبلی</button>
        </div>
        <div class="form-group align-center" style="width: 50%">
            <select id="roomss" onchange="ChangeRooms()" style="width: 100%" name="rooms[]" multiple="multiple" class="form-control js-select" asp-items="@ViewBag.Rooms"></select>
        </div>
        <div>
            <button onclick="nextWeek()" class="btn btn-outline-secondary">بعدی</button>
        </div>
    </div>
    <div class="card-body p-3">
        <div id="DataContainer" class="px-4"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            await Load("");
            LoadSelect();
        });

        async function Load(start, week) {
            var rooms = $('#roomss').val();
            var response = await fetch("/RoomPrice/List?start=" + start + "&week=" + week, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(rooms)
            });
            if (response.ok) {
                var res = await response.text();
                document.getElementById('DataContainer').innerHTML = res;
            }
        }

        async function SendEdit() {
            const form = document.getElementById('CalendarFormm');
            const formData = new FormData(form);
            const response = await fetch('/RoomPrice/UpdateView', {
                method: 'POST',
                body: formData
            });
            const date = document.getElementById("start").value;
            await Load(date, "");
        }

        async function ChangeRooms() {
            var rooms = $('#roomss').val();
            var date = document.getElementById("start").value;
            var response = await fetch("/RoomPrice/List?start=" + date, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(rooms)
            });
            if (response.ok) {
                var res = await response.text();
                document.getElementById('DataContainer').innerHTML = res;
            }
        }

        async function lastWeek() {
            var date = document.getElementById("start").value;
            await Load(date, "last");
        }

        async function nextWeek() {
            var date = document.getElementById("start").value;
            await Load(date, "next");
        }

        async function Create() {
            $('#MyModal').modal('show');
            var response = await fetch("/RoomPrice/CreateViews");
            if (response.ok) {
                var res = await response.text();
                $('#Modalbody').html(res);
                LoadDatePicker();
                LoadSelect();
            }
        }

        async function SendCreate() {
            const form = document.getElementById('createForm');
            const formData = new FormData(form);
            try {
                const response = await fetch('/RoomPrice/CreateRoomPrice', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                const Toast = Swal.mixin({
                    toast: true,
                    position: "top-start",
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.onmouseenter = Swal.stopTimer;
                        toast.onmouseleave = Swal.resumeTimer;
                    }
                });

                if (response.ok) {
                    Toast.fire({
                        icon: "success",
                        title: "عملیات با موفقیت انجام شد"
                    });
                    $('#MyModal').modal('hide');
                } else {
                    Toast.fire({
                        icon: "error",
                        title: result.details
                    });
                }
            } catch (error) {
                console.error('Fetch error:', error);
            }
        }

        function LoadSelect() {
            $('.js-select').select2();
            let allOptions = [];
            $('.js-select option').each(function () {
                allOptions.push($(this).val());
            });
            $('.js-select').val(allOptions).trigger('change');
        }

        function LoadDatePicker() {
            $(".example1").pDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: false,
                autoClose: true
            });
        }
    </script>
}
